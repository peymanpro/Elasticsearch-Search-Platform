# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Python, config, docs, data — always LF
*.py       text eol=lf
*.pyi      text eol=lf
*.md       text eol=lf
*.rst      text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.jsonl    text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf
*.sh       text eol=lf
Dockerfile text eol=lf

# Windows-only scripts — CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary assets — no conversion
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary

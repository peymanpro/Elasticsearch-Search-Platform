# Local development environment template.
# Copy to .env and adjust as needed. The .env file itself is gitignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT=10
ELASTICSEARCH_MAX_RETRIES=3

# --- Index configuration ---
SEARCH_INDEX_ALIAS=products
SEARCH_INDEX_VERSION=v1
